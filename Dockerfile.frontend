# syntax=docker/dockerfile:1
# rugcharts-frontend — React/Vite SPA
# Multi-stage: npm builder → nginx runtime
# Target: static production bundle served by nginx

# ── Stage 1: Builder ────────────────────────────────────────────────
# Use Debian-based node (glibc) — Alpine/musl lacks @rollup/rollup-linux-x64-musl
# which `npm ci` does not install for the musl platform, breaking the Vite build.
FROM node:22-slim AS builder

WORKDIR /app

# Install dependencies (frozen lockfile for reproducible builds)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --frozen-lockfile

# Copy source and build
COPY frontend/ ./
RUN npm run build

# ── Stage 2: Runtime (nginx) ────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Non-root user (uid 1000)
RUN addgroup -g 1000 app && \
    adduser -D -u 1000 -G app app

# Copy built assets
COPY --from=builder --chown=app:app /app/dist /usr/share/nginx/html

# Self-contained nginx config (replaces stock nginx.conf): SPA fallback,
# gzip, security headers, non-root temp paths under /tmp.
COPY nginx.conf /etc/nginx/nginx.conf

# Remove the stock entrypoint scripts — they try to rewrite config files on a
# read-only rootfs and would crash the container. Our config is self-contained.
RUN rm -rf /docker-entrypoint.d/

USER 1000:1000

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["wget", "-qO-", "http://127.0.0.1:8080/"]

# Create the writable temp dir under /tmp (tmpfs, world-writable) at startup,
# then exec nginx. Required because the /tmp tmpfs is mounted fresh at runtime.
CMD ["sh", "-c", "mkdir -p /tmp/nginx && exec nginx -g 'daemon off;'"]
